QQQ_DEPLOYMENT=dev

RDBMS_VENDOR=mysql
RDBMS_HOSTNAME=localhost
RDBMS_PORT=3306
RDBMS_DATABASE_NAME=kof-website
RDBMS_USERNAME=root
RDBMS_PASSWORD=my-secret-pw

QQQ_ENV_MATERIAL_UI_LICENSE_KEY=<Optionally, a license key for MaterialUI.  Without this data grids will show a watermark.>

OAUTH2_BASE_URL="http://localhost:3000"
OAUTH2_CLIENT_ID="kof-website"
OAUTH2_CLIENT_SECRET="my-secret"
OAUTH2_SCOPES=openid profile email

